{
    "compilerOptions": {
      "target": "ESnext",
      "module": "ESnext",
      "allowJs": true,
      "allowSyntheticDefaultImports": true,
      "sourceMap": true,
      "removeComments": true,
      "declaration": true,
      "declarationDir": "./types",
      "outDir": "dist",
      "rootDir": "./src",
      "strictNullChecks": false,
      "strict": true,
      "noImplicitAny": true,
      "moduleResolution": "bundler",
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "forceConsistentCasingInFileNames": true
    },
    "lib": [
      "esNext",
      "dom",
      "es5"
    ],
    "include": [
      "src/**/*"
    ]
  }
